<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="Current">
  <ItemGroup>
    <Manifest Include="app.manifest" />
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="App.xaml.h" />
    <ClInclude Include="EditorProfiles.h" />
    <ClInclude Include="FileStore.h" />
    <ClInclude Include="MainWindow.xaml.h" />
    <ClInclude Include="SnapshotJson.h" />
    <ClInclude Include="UiStrings.h" />
    <ClInclude Include="WinUIEditAdapter.h" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="CoreWire.h" />
    <ClInclude Include="CoreRunner.h" />
    <ClInclude Include="SaveBaseline.h" />
    <ClInclude Include="RunnerConfiguration.h" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="App.xaml.cpp" />
    <ClCompile Include="EditorProfiles.cpp" />
    <ClCompile Include="FileStore.cpp" />
    <ClCompile Include="MainWindow.xaml.cpp" />
    <ClCompile Include="SnapshotJson.cpp" />
    <ClCompile Include="WinUIEditAdapter.cpp" />
    <ClCompile Include="pch.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <ClCompile Include="CoreWire.cpp" />
    <ClCompile Include="CoreRunner.cpp" />
    <ClCompile Include="RunnerConfiguration.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="App.idl" />
    <Midl Include="MainWindow.idl" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Include="Strings\en-US\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="editor-profiles.json" />
    <Content Include="$(CPNGeneratedToolchainsDir)\*.json" />
    <Content Include="..\..\..\tools\windows\profiles\cpp-clang-windows.json" />
    <Content Include="..\..\..\resources\profiles\cpp-gcc-windows.json" />
    <Content Include="..\..\..\tools\windows\profiles\python-windows.json" />
    <None Include="packages.config" />
    <Content Include="..\NOTICE.md" />
    <Content Include="..\..\..\third_party\WinUIEdit\LICENSE" />
    <Content Include="..\..\..\third_party\WinUIEdit\scintilla\License.txt" />
    <Content Include="..\..\..\third_party\WinUIEdit\lexilla\License.txt" />
    <Content Include="runner-settings.json" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="Assets\Square150x150Logo.scale-200.png" />
    <Image Include="Assets\Square44x44Logo.scale-200.png" />
    <Image Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Wide310x150Logo.scale-200.png" />
    <Image Include="Assets\SplashScreen.scale-200.png" />
  </ItemGroup>
</Project>
