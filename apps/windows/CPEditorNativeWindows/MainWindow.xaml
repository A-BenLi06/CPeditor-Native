<Window
    x:Class="CPEditorNativeWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Unified Slim Fluent Top Bar -->
        <Border Grid.Row="0"
                Padding="8,4,10,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Native MenuBar + Quick Transport Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <MenuBar x:Name="TopMenuBar" VerticalAlignment="Center">
                        <MenuBarItem x:Uid="MenuFile">
                            <MenuFlyoutItem x:Name="MenuNewItem" x:Uid="MenuNew" Click="New_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuOpenItem" x:Uid="MenuOpen" Click="Open_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuSaveItem" x:Uid="MenuSave" Click="Save_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuSaveAsItem" x:Uid="MenuSaveAs" Click="SaveAs_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuSaveAllItem" x:Uid="MenuSaveAll" Click="SaveAll_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control,Menu" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuCloseTabItem" x:Uid="MenuCloseTab" Click="CloseTab_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="W" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuCloseSavedItem" x:Uid="MenuCloseSaved" Click="CloseSavedTabs_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Uid="MenuRecovery">
                                <MenuFlyoutItem x:Name="MenuRetryRecoveryItem" x:Uid="MenuRetryRecovery" Click="RetryRecovery_Click" />
                                <MenuFlyoutItem x:Name="MenuSaveRecoveryAsItem" x:Uid="MenuSaveRecoveryAs" Click="SaveRecoveryAs_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="MenuExportSnapshotItem" x:Uid="MenuExportSnapshot" Click="Export_Click" />
                        </MenuBarItem>

                        <MenuBarItem x:Uid="MenuEdit">
                            <MenuFlyoutItem x:Name="MenuUndoItem" x:Uid="MenuUndo" Click="Undo_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Z" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuRedoItem" x:Uid="MenuRedo" Click="Redo_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Y" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="MenuWordWrapItem" x:Uid="MenuWordWrap" Click="ToggleWordWrap_Click">
                                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Z" Modifiers="Menu" />
                                </ToggleMenuFlyoutItem.KeyboardAccelerators>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="MenuAutoPairItem" x:Uid="MenuAutoPair" Click="ToggleAutoPair_Click" />
                        </MenuBarItem>

                        <MenuBarItem x:Uid="MenuView">
                            <MenuFlyoutItem x:Uid="MenuViewEditorOnly" Click="ViewEditorOnly_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuViewSplit" Click="ViewSplit_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuViewTestsOnly" Click="ViewTestsOnly_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number3" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="MenuToggleTestPanel" Click="ToggleTestPanel_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Y" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MenuCompanionInbox" Click="ToggleCompanionPane_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="I" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>

                        <MenuBarItem x:Uid="MenuRun">
                            <MenuFlyoutItem x:Name="MenuCompileItem" x:Uid="MenuCompile" Click="Compile_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="B" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuRunOnlyItem" x:Uid="MenuRunOnly" Click="RunOnly_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="R" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuCompileAndRunItem" x:Uid="MenuCompileAndRun" Click="Run_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="R" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuStopItem" x:Uid="MenuStop" Click="Cancel_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" Modifiers="Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuAddSampleItem" x:Uid="MenuAddSample" Click="AddTest_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="T" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuConfigureCheckerItem" x:Uid="MenuConfigureChecker" Click="ConfigureChecker_Click" />
                        </MenuBarItem>

                        <MenuBarItem x:Uid="MenuTools">
                            <MenuFlyoutItem x:Name="MenuSettingsItem" x:Uid="MenuSettings" Click="Settings_Click" />
                            <MenuFlyoutItem x:Name="MenuRescanToolchainsItem" x:Uid="MenuRescanToolchains" Click="RescanToolchains_Click" />
                        </MenuBarItem>
                    </MenuBar>

                    <Border Width="1" Height="16" Margin="4,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <StackPanel x:Name="Commands" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="TopCompileButton" Style="{StaticResource FluentIconButtonStyle}" Click="Compile_Click" IsEnabled="False">
                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                        </Button>
                        <Button x:Name="TopRunButton" Style="{StaticResource FluentIconButtonStyle}" Click="Run_Click" IsEnabled="False">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                        <Button x:Name="TopStopButton" Style="{StaticResource FluentIconButtonStyle}" Click="Cancel_Click" IsEnabled="False" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Language + Toolchain Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox x:Name="Profiles" x:Uid="Profiles" MinWidth="104" SelectionChanged="Profile_SelectionChanged" />
                    <ComboBox x:Name="Toolchains" x:Uid="Toolchains" MinWidth="164" SelectionChanged="Toolchain_SelectionChanged" />
                    <TextBlock x:Name="ToolchainAvailabilityText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- Right: Companion + Settings + Single Inspector Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ToggleButton x:Name="CompanionToggleButton"
                                  Click="ToggleCompanionPane_Click"
                                  CornerRadius="6"
                                  Padding="8,5"
                                  BorderThickness="0"
                                  Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="CompanionBtnLabel" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="SettingsButton"
                            x:Uid="SettingsBtn"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Click="Settings_Click">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="16" Margin="2,0" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <ToggleButton x:Name="InspectorToggleButton"
                                  Click="InspectorToggle_Click"
                                  CornerRadius="6"
                                  Padding="7,5"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  IsChecked="True">
                        <FontIcon Glyph="&#xE89F;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Full-Height Split Workspace (Left Pane with Scoped TabView + Status Bar | Right Full-Height Inspector) -->
        <Grid x:Name="WorkspaceSplit" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="SplitterColumn" Width="7" />
                <ColumnDefinition x:Name="RightColumn" Width="510" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: TabView + RecoveryInfoBar + EditorDeck + Slim Status Bar -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabView x:Name="Tabs"
                         Grid.Row="0"
                         TabWidthMode="Equal"
                         IsAddTabButtonVisible="True"
                         CanReorderTabs="True"
                         CanDragTabs="True"
                         AllowDropTabs="True"
                         TabItemsChanged="Tabs_TabItemsChanged"
                         AddTabButtonClick="Tabs_AddTabButtonClick"
                         TabCloseRequested="Tabs_CloseRequested"
                         SelectionChanged="Tabs_SelectionChanged" />

                <InfoBar x:Name="RecoveryInfoBar"
                         Grid.Row="1"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="RetryRecoveryButton" x:Uid="RetryRecovery" Click="RetryRecovery_Click" IsEnabled="False" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <Button x:Name="SaveRecoveryAsButton" x:Uid="SaveRecoveryAs" Click="SaveRecoveryAs_Click" IsEnabled="False" Margin="0,0,0,8" />
                    </InfoBar.Content>
                </InfoBar>

                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid x:Name="EditorDeck" />
                </Border>

                <!-- Slim Editor Status Bar (scoped cleanly to Editor Column) -->
                <Border Grid.Row="3"
                        Padding="12,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusLanguageText" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusCursorText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StatusEncodingText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="StatusBytesText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="Status"
                                   Grid.Column="1"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusCompanionText" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                            <Button x:Name="StatusWrapButton"
                                    Style="{StaticResource FluentIconButtonStyle}"
                                    Click="ToggleWordWrap_Click"
                                    Padding="6,2"
                                    FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Draggable Fluent Split Handle (1px hairline + centered grabber pill on hover/drag) -->
            <Grid x:Name="SplitHandle"
                  Grid.Column="1"
                  Background="Transparent"
                  PointerPressed="SplitHandle_PointerPressed"
                  PointerMoved="SplitHandle_PointerMoved"
                  PointerReleased="SplitHandle_PointerReleased"
                  PointerCaptureLost="SplitHandle_PointerCaptureLost"
                  PointerEntered="SplitHandle_PointerEntered"
                  PointerExited="SplitHandle_PointerExited">
                <Border x:Name="SplitLine"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Border x:Name="SplitPill"
                        Width="3"
                        Height="32"
                        CornerRadius="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            </Grid>

            <!-- Right Column: Full-Height Native Fluent Inspector (Tests & Output OR Companion Inbox) -->
            <Grid x:Name="RightPane" Grid.Column="2" Background="{ThemeResource LayerFillColorAltBrush}">
                <!-- Tests & Output Inspector -->
                <Grid x:Name="TestsPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Single-Layer Unified Inspector Header -->
                    <Border Grid.Row="0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <!-- Title Row: Test Cases + Summary Pill + Circular + / ... -->
                            <Grid Padding="14,10,14,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="TestCasesHeaderText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border x:Name="SummaryBadge" CornerRadius="10" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="SummaryBadgeText" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <Border x:Name="OutdatedBadge"
                                            CornerRadius="10"
                                            Padding="7,2"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="OutdatedBadgeText"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="AddTestButton"
                                            Style="{StaticResource FluentRoundIconButtonStyle}"
                                            Click="AddTest_Click"
                                            IsEnabled="False">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="MoreSamplesButton"
                                            Style="{StaticResource FluentRoundIconButtonStyle}"
                                            IsEnabled="False">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Name="MenuEnableAllSamplesItem" Click="EnableAllSamples_Click" />
                                                <MenuFlyoutItem x:Name="MenuDisableAllSamplesItem" Click="DisableAllSamples_Click" />
                                                <MenuFlyoutItem x:Name="MenuRemoveDisabledSamplesItem" Click="RemoveDisabledSamples_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Name="UseAllOutputsItem" Click="UseAllOutputs_Click" />
                                                <MenuFlyoutItem x:Name="DeleteAllSamplesItem" Click="DeleteAllSamples_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Equal-Width Compile / Run / Compile & Run Strip + Checker Property Row -->
                            <StackPanel Padding="14,0,14,10" Spacing="8">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ExecCol0" Width="*" />
                                        <ColumnDefinition x:Name="ExecCol1" Width="*" />
                                        <ColumnDefinition x:Name="ExecCol2" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompileButton"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Padding="8,5"
                                            Click="Compile_Click"
                                            IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE943;" FontSize="12" />
                                            <TextBlock x:Name="CompileBtnLabel" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RunOnlyButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Padding="8,5"
                                            Click="RunOnly_Click"
                                            IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock x:Name="RunOnlyBtnLabel" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RunButton"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Padding="8,5"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="Run_Click"
                                            IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock x:Name="CompileAndRunBtnLabel" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CancelButton"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Padding="8,5"
                                            Click="Cancel_Click"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock x:Name="StopBtnLabel" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Inspector Property Row: Checker Label + Native DropDownButton -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckerPrefixText"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <DropDownButton x:Name="CheckerMenuButton"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,4"
                                                    CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="CheckerMenuIcon" Glyph="&#xE9E9;" FontSize="12" />
                                            <TextBlock x:Name="CheckerMenuLabel" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <ToggleMenuFlyoutItem x:Name="MenuUseExternalCheckerItem" Click="UseExternalCheckerMenu_Click" />
                                                <MenuFlyoutItem x:Name="MenuCheckerSettingsItem" Click="ConfigureChecker_Click" />
                                                <MenuFlyoutSeparator />
                                                <RadioMenuFlyoutItem x:Name="MenuCompareTrailingItem" GroupName="ComparisonPolicy" Click="ComparisonPolicy_Click" />
                                                <RadioMenuFlyoutItem x:Name="MenuCompareStrictItem" GroupName="ComparisonPolicy" Click="ComparisonPolicy_Click" />
                                                <RadioMenuFlyoutItem x:Name="MenuCompareByteItem" GroupName="ComparisonPolicy" Click="ComparisonPolicy_Click" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Per-Document Test & Compiler Cards Scroll Deck -->
                    <Grid x:Name="TestDeck" Grid.Row="1" />
                </Grid>

                <!-- Upgraded Companion Inbox Inspector (Fluent SelectorBar + Card Previews) -->
                <Grid x:Name="CompanionPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14,10"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompanionPaneTitle"
                                           Grid.Column="0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="ImportCompanionButton" x:Uid="ImportCompanion" Click="ImportCompanion_Click" IsEnabled="False" Padding="8,4" FontSize="12" CornerRadius="6" />
                                    <Button x:Name="RefreshCompanionButton" x:Uid="RefreshCompanion" Click="RefreshCompanion_Click" IsEnabled="False" Padding="8,4" FontSize="12" CornerRadius="6" />
                                    <Button x:Name="MoreCompanionButton" x:Uid="MoreCompanion" Click="MoreCompanion_Click" IsEnabled="False" Padding="8,4" FontSize="12" CornerRadius="6" />
                                </StackPanel>
                            </Grid>
                            <SelectorBar x:Name="CompanionFilterBar" SelectionChanged="CompanionFilterBar_SelectionChanged">
                                <SelectorBarItem x:Name="CompanionFilterAllItem" IsSelected="True" />
                                <SelectorBarItem x:Name="CompanionFilterPendingItem" />
                                <SelectorBarItem x:Name="CompanionFilterAppliedItem" />
                            </SelectorBar>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="StartCompanionButton" x:Uid="StartCompanion" Click="StartCompanion_Click" IsEnabled="False" Padding="8,4" FontSize="12" CornerRadius="6" />
                                    <Button x:Name="StopCompanionButton" x:Uid="StopCompanion" Click="StopCompanion_Click" IsEnabled="False" Padding="8,4" FontSize="12" CornerRadius="6" />
                                </StackPanel>
                                <TextBlock x:Name="CompanionListenerStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="CompanionNotice" Grid.Row="1" Margin="14,6" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                    <ListView x:Name="CompanionItems"
                              Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="Companion_SelectionChanged"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,1" />

                    <!-- Pinned Header + Sample Detail Preview -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="14,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="CompanionDetailTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CompanionDetailMeta" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Button x:Name="ApplyCompanionButton"
                                        x:Uid="ApplyCompanion"
                                        Grid.Column="1"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="ApplyCompanion_Click"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"
                                        CornerRadius="6" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CompanionPreviewPanel" Padding="14,10" Spacing="10" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
