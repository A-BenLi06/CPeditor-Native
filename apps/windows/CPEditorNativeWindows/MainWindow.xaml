<Window
    x:Class="CPEditorNativeWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar x:Name="Commands" DefaultLabelPosition="Right" IsEnabled="False">
            <AppBarButton x:Name="NewButton" x:Uid="NewCommand" Icon="Page2" Click="New_Click" />
            <AppBarButton x:Name="OpenButton" x:Uid="OpenCommand" Icon="OpenFile" Click="Open_Click" />
            <AppBarButton x:Name="SaveButton" x:Uid="SaveCommand" Icon="Save" Click="Save_Click" />
            <AppBarButton x:Name="SaveAsButton" x:Uid="SaveAsCommand" Icon="SaveLocal" Click="SaveAs_Click" />
            <AppBarButton x:Name="ExportButton" x:Uid="ExportCommand" Icon="Download" Click="Export_Click" />
            <CommandBar.Content>
                <ComboBox x:Name="Profiles" x:Uid="Profiles" Margin="12,4" MinWidth="140"
                          SelectionChanged="Profile_SelectionChanged" />
            </CommandBar.Content>
        </CommandBar>
        <TabView x:Name="Tabs" Grid.Row="1" IsAddTabButtonVisible="False"
                 TabCloseRequested="Tabs_CloseRequested" SelectionChanged="Tabs_SelectionChanged" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="EditorDeck" />
            <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Margin="12">
                    <ComboBox x:Name="Toolchains" x:Uid="Toolchains" HorizontalAlignment="Stretch"
                              SelectionChanged="Toolchain_SelectionChanged" />
                    <ComboBox x:Name="Comparisons" x:Uid="Comparisons" HorizontalAlignment="Stretch"
                              SelectionChanged="Comparison_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" x:Uid="RunAll" Click="Run_Click" IsEnabled="False" />
                        <Button x:Name="CancelButton" x:Uid="CancelRun" Click="Cancel_Click" IsEnabled="False" />
                        <Button x:Name="AddTestButton" x:Uid="AddTest" Click="AddTest_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="TestDeck" Grid.Row="1" />
            </Grid>
        </Grid>
        <Border Grid.Row="3" Padding="12,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RetryRecoveryButton" x:Uid="RetryRecovery" Click="RetryRecovery_Click" IsEnabled="False" />
                    <Button x:Name="SaveRecoveryAsButton" x:Uid="SaveRecoveryAs" Click="SaveRecoveryAs_Click" IsEnabled="False" />
                    <TextBlock x:Name="RecoveryStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
