{
  "schema_version": 1,
  "id": "cpp-msvc",
  "language_id": "cpp",
  "source_filename": "main.cpp",
  "artifact_name": "solution.exe",
  "build": {
    "executable": "cl.exe",
    "arguments": ["/nologo", "/std:c++20", "/EHsc", "/utf-8", "/O2", "/I", "${source_dir}", "${source}", "/Fe:${artifact}"]
  },
  "run": { "executable": "${artifact}", "arguments": [] },
  "build_limits": { "wall_timeout_ms": 30000 },
  "run_limits": { "wall_timeout_ms": 2000 },
  "inherit_environment": true,
  "environment": [],
  "variables": []
}
